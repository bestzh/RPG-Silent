  RequiredLevel: 12
  RequiredAffinity: 0
  Order: 100
  Pages:
  - "\u963F\u767B\u6536\u5230\u4E00\u5C01\u4ECE\u6D1E\u7A9F\u9001\u56DE\u7684\u4FE1\u3002\u5B88\u671B\u8005\u7684\u788E\u7247\u5DF2\u7ECF\u51B7\u5374\uFF0C\u88C2\u7F1D\u5374\u4ECD\u4F1A\u5728\u5165\u591C\u65F6\u4EAE\u8D77\u3002\u94C1\u5320\u8BA4\u51FA\u90A3\u9053\u5149\u4E0E\u68EE\u6797\u8DEF\u6807\u4E0A\u7684\u7EC6\u7EB9\u76F8\u540C\u3002\u57CE\u91CC\u7684\u4EBA\u9700\u8981\u7684\u4E0D\u662F\u53C8\u4E00\u6B21\u6377\u62A5\uFF0C\u800C\u662F\u4E00\u6761\u80FD\u957F\u671F\u8D70\u4E0B\u53BB\u7684\u9053\u8DEF\u3002"
  - "\u53EF\u4EE5\u5148\u52A0\u56FA\u88C2\u7F1D\uFF0C\u4FDD\u969C\u5DE1\u8DEF\u8005\u7684\u5B89\u5168\uFF1B\u4E5F\u53EF\u4EE5\u8D81\u56DE\u58F0\u5C1A\u5B58\uFF0C\u628A\u6700\u540E\u4E00\u6BB5\u53E4\u8001\u8BB0\u5F55\u5E26\u56DE\u6765\u3002\u963F\u767B\u613F\u610F\u5C0A\u91CD\u4F60\u7684\u5224\u65AD\u3002\u51B3\u5B9A\u53EA\u5F71\u54CD\u4E00\u6761\u540E\u7EED\u59D4\u6258\uFF0C\u4E0D\u4F1A\u5C01\u9501\u7B2C\u4E94\u7AE0\u4E0E\u5171\u540C\u7EC8\u7AE0\uFF0C\u4E5F\u4E0D\u80FD\u5728\u653E\u5F03\u4EFB\u52A1\u540E\u6539\u9009\u3002"
  Choices:
  - Id: seal
    Label: "\u5148\u52A0\u56FA\u88C2\u7F1D"
    Outcome: "\u963F\u767B\u8BF7\u94C1\u5320\u51C6\u5907\u6676\u6838\uFF0C\u5F00\u653E\u2018\u88C2\u9699\u7684\u8FB9\u754C\u2019\uFF1B\u2018\u6700\u540E\u7684\u5171\u9E23\u2019\u4E0D\u518D\u5F00\u653E\u3002\u5171\u540C\u4E3B\u7EBF\u4ECD\u53EF\u7EE7\u7EED\u3002"
