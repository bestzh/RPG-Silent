  Id: market-aid
  Title: "\u5E02\u96C6\u7684\u96BE\u9898"
  Role: 4
  Pages:
  - "\u7F57\u838E\uFF1A\u6700\u8FD1\u603B\u6709\u4EBA\u95EE\u6211\u4E3A\u4EC0\u4E48\u8FD8\u575A\u6301\u5F00\u5E97\u3002\u57CE\u91CC\u5B69\u5B50\u7684\u5348\u996D\u3001\u5DE1\u903B\u961F\u7684\u836F\u7BB1\uFF0C\u5F88\u591A\u4E1C\u897F\u90FD\u8981\u4ECE\u8FD9\u91CC\u9001\u51FA\u53BB\u3002"
  - "\u7F57\u838E\uFF1A\u8D27\u67B6\u7F3A\u6750\u6599\uFF0C\u5546\u961F\u4E5F\u7F3A\u4EBA\u624B\u3002\u4F60\u53EF\u4EE5\u5E2E\u5FD9\u8865\u8D27\uFF0C\u4E5F\u53EF\u4EE5\u66FF\u5546\u961F\u6E05\u7406\u4E00\u6BB5\u8DEF\u3002\u4F60\u66F4\u613F\u610F\u505A\u54EA\u4EF6\u4E8B\uFF1F"
  Choices:
  - Id: supply
    Label: "\u5E2E\u4F60\u8865\u9F50\u8D27\u67B6\u7684\u6750\u6599"
    Outcome: "\u7F57\u838E\u5F88\u611F\u6FC0\u4F60\u3002\u89E3\u9501\u652F\u7EBF\u300C\u5E02\u96C6\u63F4\u624B\u300D\uFF0C\u4EA4\u4ED8\u6750\u6599\u83B7\u5F97\u989D\u5916\u597D\u611F\u4E0E\u6676\u6838\u788E\u7247\u3002"
    Gold: 30
    Experience: 40
    Affinity: 20
  - Id: escort
    Label: "\u5148\u4E3A\u5546\u961F\u6E05\u7406\u901A\u8DEF"
    Outcome: "\u7F57\u838E\u4F1A\u4E3A\u5DE1\u8DEF\u4ED8\u916C\u3002\u89E3\u9501\u652F\u7EBF\u300C\u5546\u8DEF\u5B88\u671B\u300D\uFF0C\u51FB\u8D25\u68EE\u6797\u654C\u4EBA\u83B7\u5F97\u91D1\u5E01\u5956\u52B1\u3002"
