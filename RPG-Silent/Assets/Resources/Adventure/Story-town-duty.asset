  Id: town-duty
  Title: "\u9759\u8C27\u57CE\u7684\u4E24\u6761\u8DEF"
  Role: 2
  Pages:
  - "\u963F\u767B\uFF1A\u8FD9\u5EA7\u57CE\u4F9D\u9760\u5546\u961F\u4E0E\u63A2\u9669\u8005\u7EF4\u6301\u751F\u8BA1\u3002\u6797\u95F4\u7684\u7CBE\u82F1\u9891\u7E41\u88AD\u6270\uFF0C\u800C\u65E7\u9057\u8FF9\u91CC\u4E5F\u53EF\u80FD\u85CF\u7740\u91CD\u5EFA\u7684\u7EBF\u7D22\u3002"
  - "\u963F\u767B\uFF1A\u5DE1\u9632\u961F\u548C\u63A2\u9669\u961F\u90FD\u9700\u8981\u5E2E\u624B\u3002\u4F60\u613F\u610F\u5148\u5B88\u62A4\u9053\u8DEF\uFF0C\u8FD8\u662F\u5BFB\u627E\u9057\u8FF9\u91CC\u7684\u7B54\u6848\uFF1F\u8FD9\u4EFD\u51B3\u5B9A\u4F1A\u6539\u53D8\u6211\u4EA4\u7ED9\u4F60\u7684\u4E0B\u4E00\u4EFD\u59D4\u6258\u3002"
  Choices:
  - Id: protect
    Label: "\u6211\u6765\u6E05\u7406\u9053\u8DEF\u4E0A\u7684\u5A01\u80C1"
    Outcome: "\u963F\u767B\u8BA4\u53EF\u4F60\u7684\u62C5\u5F53\u3002\u89E3\u9501\u652F\u7EBF\u300C\u5DE1\u9632\u5148\u950B\u300D\uFF0C\u4EE5\u91D1\u5E01\u548C\u953B\u9020\u6750\u6599\u4E3A\u4E3B\u8981\u5956\u52B1\u3002"
    Gold: 40
    Experience: 40
    Affinity: 15
  - Id: explore
    Label: "\u6211\u60F3\u8C03\u67E5\u9057\u8FF9\u4E0E\u65E7\u8865\u7ED9"
    Outcome: "\u963F\u767B\u652F\u6301\u4F60\u7684\u8C03\u67E5\u3002\u89E3\u9501\u652F\u7EBF\u300C\u9057\u8FF9\u5148\u884C\u8005\u300D\uFF0C\u4EE5\u7ECF\u9A8C\u548C\u6676\u6838\u6750\u6599\u4E3A\u4E3B\u8981\u5956\u52B1\u3002"
    Gold: 20
    Experience: 70
    Affinity: 10
